# Cloudflare Pages custom headers — controls browser caching behavior.
#
# index.html (and its aliases) must NEVER be cached aggressively: this is
# the file that changes with every update, so without this, browsers can
# keep showing users an old version indefinitely even after a new deploy.
# "no-cache" doesn't mean "never store" — it means the browser must always
# revalidate with the server before using any cached copy, so updates are
# picked up on the very next load while still allowing fast conditional
# (304 Not Modified) responses when nothing has changed.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# kids-arcade.html, number-jungle-game-engine.html, etc. are also
# frequently-updated app files, not static assets — same rule applies.
/*.html
  Cache-Control: no-cache

# category-image.js, category-education.js, etc. are lazy-loaded at runtime
# (index.source.html injects <script src="category-<cat>.js"> the first time
# a tool from that category opens) and are updated often, same as index.html
# itself. Without this rule, Cloudflare's default long-lived caching for
# static assets meant a browser (or the CDN edge) could keep serving an old,
# already-fixed-on-GitHub version of a category file for a long time after
# every deploy — this is the "same tool still looks/behaves old" / general
# cache problem users hit repeatedly. This makes every .js file always
# revalidate with the server, same as the app shell.
/*.js
  Cache-Control: no-cache

# thirukkural-daily.json is fetched at runtime and changes daily — must
# also always revalidate, or users can get stuck seeing yesterday's kural.
/*.json
  Cache-Control: no-cache
