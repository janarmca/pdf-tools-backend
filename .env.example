# இந்த file-ஐ .env என்று copy செய்து, உண்மையான மதிப்புகளை நிரப்பவும்.
# .env-ஐ ஒருபோதும் GitHub-க்கு commit செய்யாதீர்கள்!

# Supabase Dashboard → Settings → API-ல் கிடைக்கும்
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE   # ⚠️ இது ரகசியமானது — client-side-ல் ஒருபோதும் பயன்படுத்தாதீர்கள்

# Razorpay Dashboard → Settings → API Keys-ல் கிடைக்கும்
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Text-to-Image tool — Cloudflare Workers AI (genuinely free, ~10,000 Neurons/day,
# no credit card needed). Account ID is visible in the Cloudflare dashboard
# (same account as this project's Cloudflare Pages frontend). API token:
# dash.cloudflare.com → My Profile → API Tokens → Create Token → "Workers AI" template (Read scope).
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE

# AI vision tools (photo/scan uploads — Ask AI, Handwriting, Receipt, and the
# vision-fallback path of Summarize/Translate/Resume Reviewer) — Google AI Studio
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# AI text-only tools (Summarize/Resume Reviewer when a real text layer was
# extracted client-side — no photo/scan involved — plus Resume Builder's
# "AI suggest" buttons) — build.nvidia.com, free tier, no credit card needed.
# console: build.nvidia.com → sign in → any model page → "Get API Key"
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE

# எந்த port-ல் server ஓட வேண்டும்
PORT=8080

# உங்கள் frontend domain (CORS-க்கு) — claude.ai artifact preview அல்லது உங்கள் hosted domain
ALLOWED_ORIGIN=*

# NVIDIA speech-to-text (Audio/Video → Text tool). Uses the same NVIDIA_API_KEY.
# Optional overrides — defaults are openai/whisper-large-v3 on build.nvidia.com:
# NVIDIA_ASR_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# NVIDIA_ASR_SERVER=grpc.nvcf.nvidia.com:443
# Optional: comma-separated fallback chat models for /api/ai/text
# NVIDIA_TEXT_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-nano-3-30b-a3b
