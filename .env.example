# The backend is the Cloudflare Worker in cloudflare/. Its keys are GitHub repository secrets
# (Settings → Secrets and variables → Actions); the "Deploy Cloudflare API" workflow copies them into the Worker.
# Full instructions (Tamil): cloudflare/README.md. Never commit real values.
#
# required
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AUTH_JWT_SECRET=            # openssl rand -hex 32
# e-mail login codes (free): Brevo (300/day) or Resend (100/day)
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=PDF Tools India <no-reply@pdftoolsindia.com>
# Google sign-in (Google Cloud Console → OAuth client; redirect URI https://pdftoolsindia.com/cfapi/auth/v1/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Razorpay (webhook URL: https://pdftoolsindia.com/cfapi/api/payment/webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# AI tools / Astrology+
GEMINI_API_KEY=
NVIDIA_API_KEY=
ASTROLOGER_API_KEY=
# optional: matrimony admin e-mails, comma separated
MAT_ADMIN_EMAILS=
